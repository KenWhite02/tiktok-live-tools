# TikTok username is now configured in bridge/.env
# See bridge/.env.example for the Python bridge configuration

# WebSocket Bridge (Python TikTokLive)
WS_HOST=127.0.0.1
WS_PORT=9090

# Stream overlay (add http://127.0.0.1:9091/ as a browser source)
OVERLAY_PORT=9091
# Solid overlay background (hex, e.g. 000000) if a window capture drops transparency
# OVERLAY_BG=

# Media Player Paths
MPV_PATH=mpv
YTDLP_PATH=yt-dlp
# YouTube cookies, needed when YouTube says "Sign in to confirm you're not a bot".
# Use a browser you're signed into YouTube with (chrome, firefox, safari, brave, edge)...
# YTDLP_COOKIES_FROM_BROWSER=chrome
# ...or an exported Netscape cookies.txt (takes precedence)
# YTDLP_COOKIES_FILE=./data/youtube-cookies.txt

# Bot Settings
COOLDOWN=120
MAX_DURATION=600
# Max songs one viewer can have playing + waiting at once (host is exempt)
MAX_REQUESTS_PER_USER=2
DEFAULT_VOLUME=30

# Database
DATABASE_PATH=./data/bot.db

# MPV Socket
MPV_SOCKET_PATH=/tmp/tiktok-mpv.sock

# Logging
LOG_LEVEL=info
