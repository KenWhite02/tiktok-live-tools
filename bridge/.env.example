# TikTok Live Configuration
TIKTOK_USERNAME=your_tiktok_username

# Extra accounts (comma-separated) that can also use the host-only
# commands (!volume, !stop). They get moderator commands too.
HOST_USERNAMES=

# WebSocket Bridge Configuration
WS_HOST=127.0.0.1
WS_PORT=9090

# EulerStream Sign API Key (optional, for reliable WebSocket connection)
SIGN_API_KEY=

# Logging
LOG_LEVEL=info
